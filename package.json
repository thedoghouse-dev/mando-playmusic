{
  "name": "mandomusic",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron --version && electron-builder --win --x64",
    "test:desktop": "npm run build && node scripts/test-desktop.mjs && node scripts/test-playlists-desktop.mjs && node scripts/test-visuals-desktop.mjs && node scripts/test-visualizer-window.mjs && node scripts/test-window-restore.mjs && node scripts/test-genre-desktop.mjs && node scripts/test-genre-filter-desktop.mjs && node scripts/test-artwork-desktop.mjs && node scripts/test-cover-download-desktop.mjs && node scripts/test-bulk-covers-desktop.mjs",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "butterchurn": "2.6.7",
    "butterchurn-presets": "2.4.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fflate": "^0.8.3",
    "lucide": "^0.468.0",
    "milkdrop-preset-converter": "^0.1.2",
    "vite": "^7.1.0"
  },
  "main": "desktop/main.cjs",
  "description": "Mando Play Music \u2014 a local music player with MilkDrop visualizations",
  "author": "Mando",
  "build": {
    "appId": "com.mandomusic.player",
    "productName": "Mando Play Music",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "shared/**/*",
      "build/visualizer-notices.txt"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Mando-Play-Music-${version}-Setup.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mando Play Music",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Mando-Play-Music-${version}-Portable.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "music-metadata": "^12.2.3"
  }
}
